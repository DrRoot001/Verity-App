{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verity",
  "version": "0.2.0",
  "identifier": "dev.verity.assistant",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Verity",
        "width": 420,
        "height": 620,
        "minWidth": 360,
        "minHeight": 420,
        "resizable": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "contentProtected": true,
        "skipTaskbar": true,
        "decorations": true,
        "transparent": false,
        "center": false,
        "x": 40,
        "y": 80
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'"
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
