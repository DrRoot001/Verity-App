# ─────────────────────────────────────────────────────────────
# Verity — environment configuration
# Copy to .env and fill in. Never commit .env.
# PRD §22, §28.1 (no secrets in images), §33 (provider budgets)
# ─────────────────────────────────────────────────────────────

# Runtime
# local | preview | staging | production
VERITY_ENV=local
VERITY_LOG_LEVEL=INFO
# json | console
VERITY_LOG_FORMAT=json
VERITY_SERVICE_NAME=verity-api
# us | eu  (PRD §38.4 data residency)
VERITY_REGION=us

# API
VERITY_API_HOST=127.0.0.1
VERITY_API_PORT=8000
VERITY_PUBLIC_API_URL=http://127.0.0.1:8000
VERITY_PUBLIC_WEB_URL=http://127.0.0.1:3000
VERITY_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Database (PRD §24)
VERITY_DATABASE_URL=postgresql+asyncpg://verity:verity@127.0.0.1:5432/verity
VERITY_DATABASE_URL_SYNC=postgresql+psycopg://verity:verity@127.0.0.1:5432/verity
VERITY_DB_POOL_SIZE=10
VERITY_DB_MAX_OVERFLOW=10
VERITY_DB_ECHO=false

# Redis (PRD §22.1 — cache / session state / queue)
VERITY_REDIS_URL=redis://127.0.0.1:6379/0
VERITY_REDIS_SESSION_URL=redis://127.0.0.1:6379/1
VERITY_REDIS_QUEUE_URL=redis://127.0.0.1:6379/2

# Auth (PRD §10.2, §28.2)
VERITY_JWT_PRIVATE_KEY_PEM=
VERITY_JWT_PUBLIC_KEY_PEM=
VERITY_JWT_KID=dev-1
VERITY_ACCESS_TOKEN_TTL_SECONDS=900
VERITY_REFRESH_TOKEN_TTL_SECONDS=2592000
VERITY_SESSION_COOKIE_NAME=__Host-verity_session
VERITY_SECURE_COOKIES=false
VERITY_ARGON2_MEMORY_KIB=65536
VERITY_ARGON2_TIME_COST=3
VERITY_ARGON2_PARALLELISM=1

# OAuth (PRD §10.2 FR-AUTH-002/003)
VERITY_GOOGLE_CLIENT_ID=
VERITY_GOOGLE_CLIENT_SECRET=
VERITY_APPLE_CLIENT_ID=
VERITY_APPLE_TEAM_ID=
VERITY_APPLE_KEY_ID=
VERITY_APPLE_PRIVATE_KEY=

# Encryption (PRD §28.1 envelope encryption)
# base64, 32 bytes; generate: openssl rand -base64 32
VERITY_DATA_ENCRYPTION_KEY=

# Object storage (PRD §45)
# local | s3
VERITY_STORAGE_BACKEND=local
VERITY_STORAGE_LOCAL_PATH=.data/objects
VERITY_S3_BUCKET=
VERITY_S3_REGION=
VERITY_S3_ENDPOINT_URL=
VERITY_S3_ACCESS_KEY_ID=
VERITY_S3_SECRET_ACCESS_KEY=

# AI providers (PRD §20.2 — keys never leave the server, §28.1 NFR-SEC-001)
VERITY_LLM_PRIMARY_PROVIDER=groq
VERITY_GROQ_API_KEY=
VERITY_GROQ_BASE_URL=https://api.groq.com/openai/v1
VERITY_GROQ_FAST_MODEL=llama-3.1-8b-instant
VERITY_GROQ_REALTIME_MODEL=openai/gpt-oss-20b
VERITY_GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
VERITY_ANTHROPIC_API_KEY=
VERITY_ANTHROPIC_BASE_URL=
VERITY_OPENAI_API_KEY=
# local | openai | anthropic (Groq does not currently expose embeddings here)
VERITY_EMBEDDING_PROVIDER=local
VERITY_EMBEDDING_DIMENSIONS=1536

# STT providers (PRD §23)
VERITY_STT_PRIMARY_PROVIDER=null
# How long the interviewer may pause mid-sentence before the next words count as
# a new question. Raise it for slow, thoughtful speakers; lower it if two
# separate questions keep merging into one.
VERITY_QUESTION_ACCUMULATION_WINDOW_MS=2000
VERITY_DEEPGRAM_API_KEY=
VERITY_ASSEMBLYAI_API_KEY=

# Cost controls (PRD §33)
VERITY_AI_DAILY_BUDGET_USD=250
VERITY_AI_BUDGET_SOFT_THRESHOLD=0.8
VERITY_SESSION_MAX_GENERATIONS=60
VERITY_SESSION_MAX_GENERATIONS_PER_MINUTE=8
VERITY_SESSION_MAX_DURATION_MINUTES=120

# Billing (PRD §19)
# stub | stripe
VERITY_PAYMENT_PROVIDER=stub
VERITY_STRIPE_SECRET_KEY=
VERITY_STRIPE_WEBHOOK_SECRET=

# Email (PRD §38)
# console | smtp | resend
VERITY_EMAIL_PROVIDER=console
VERITY_EMAIL_FROM=no-reply@verity.local
VERITY_SMTP_URL=

# Observability (PRD §30)
VERITY_OTEL_ENABLED=false
VERITY_OTEL_EXPORTER_OTLP_ENDPOINT=
VERITY_TRACE_SAMPLE_RATIO=1.0

# Rate limiting (PRD §28.3)
VERITY_RATE_LIMIT_ENABLED=true
